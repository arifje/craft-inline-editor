{
    "name": "arifje/craft-inline-editor",
    "description": "Inline editing for Craft CMS entries on the frontend. Lets admins edit titles, plain text, URL/Link and CKEditor fields directly on the rendered page.",
    "type": "craft-plugin",
    "version": "1.8.0",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "inline-editor",
        "inline-editing",
        "frontend-editing"
    ],
    "support": {
        "issues": "https://github.com/arifje/craft-inline-editor/issues",
        "source": "https://github.com/arifje/craft-inline-editor"
    },
    "require": {
        "php": ">=8.0.2",
        "craftcms/cms": "^4.3.0|^5.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.5|^11.0|^12.0"
    },
    "suggest": {
        "craftcms/ckeditor": "Enables inline editing of CKEditor fields (3.x on Craft 4; 4.x or 5.x on Craft 5)"
    },
    "autoload": {
        "psr-4": {
            "arifje\\inlineeditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "arifje\\inlineeditor\\tests\\": "tests/php/"
        }
    },
    "scripts": {
        "test": [
            "@test:php",
            "@test:js"
        ],
        "test:php": "phpunit",
        "test:js": "node --test tests/js/*.test.js"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Inline Editor",
        "handle": "inline-editor",
        "developer": "arifje",
        "developerUrl": "https://github.com/arifje",
        "documentationUrl": "https://github.com/arifje/craft-inline-editor",
        "class": "arifje\\inlineeditor\\Plugin"
    }
}
