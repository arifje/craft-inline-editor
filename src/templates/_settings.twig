{% import "_includes/forms.twig" as forms %}

{% set groupOptions = [] %}
{% for group in userGroups %}
    {% set groupOptions = groupOptions | merge([{
        label: group.name,
        value: group.id
    }]) %}
{% endfor %}

{% if groupOptions is empty %}
    <p class="light">{{ 'No user groups found. Create a group in Users → User Groups first.' | t('inline-editor') }}</p>
{% else %}
    {{ forms.checkboxGroupField({
        label: 'Allowed User Groups' | t('inline-editor'),
        instructions: 'Members of these groups can use the inline editor on the frontend. Administrators always have access.' | t('inline-editor'),
        id: 'allowedGroupIds',
        name: 'allowedGroupIds',
        options: groupOptions,
        values: settings.allowedGroupIds
    }) }}
{% endif %}

<hr>

<h2>{{ 'CKEditor' | t('inline-editor') }}</h2>

{{ forms.selectField({
    label: 'JavaScript Config' | t('inline-editor'),
    instructions: 'Choose a CKEditor JS config from config/ckeditor/. Its toolbar, plugins and decorators will be merged into the inline editor. Select "None" to use the built-in defaults.' | t('inline-editor'),
    id: 'ckeditorConfig',
    name: 'ckeditorConfig',
    options: ckeditorConfigs,
    value: settings.ckeditorConfig
}) }}

{{ forms.selectField({
    label: 'HTML Purifier Config' | t('inline-editor'),
    instructions: 'Choose which HTML Purifier config to apply when saving CKEditor content. Config files are JSON files in config/htmlpurifier/. Select "None" to rely on the field\'s own Craft settings.' | t('inline-editor'),
    id: 'ckeditorPurifierConfig',
    name: 'ckeditorPurifierConfig',
    options: purifierConfigs,
    value: settings.ckeditorPurifierConfig
}) }}
